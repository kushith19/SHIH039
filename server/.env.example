PORT=3001
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173
AI_COMMANDER_URL=http://localhost:8000
TELE_INGESTION_URL=http://127.0.0.1:3000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Local 7B fallback heats the laptop during live attacks. Keep off; use Groq Commander or template copy.
OLLAMA_FALLBACK=0
# LLM-assisted orchestration Commander planning (default off = deterministic policy playbooks).
# When 1, analyze/replan call Ollama POST {OLLAMA_URL}/api/chat with OLLAMA_MODEL (direct).
# /commander/plan is fallback only if that request throws — never a silent policy fill-in.
LLM_RESPONSE_PLAN=0
# Optional alias: RESPONSE_PLAN_MODE=llm|deterministic
